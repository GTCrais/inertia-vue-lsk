APP_NAME="Inertia + Vue LSK"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

GRACEFULLY_HANDLE_EXCEPTIONS=

FATHOM_ACTIVE=

QUEUE_MAIL=default
QUEUE_BROADCAST=default
QUEUE_PUSH_NOTIFICATIONS=default

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=inertia_vue_lsk
DB_USERNAME=root
DB_PASSWORD=

BROADCAST_CONNECTION=pusher

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_APP_CLUSTER=eu
VITE_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
VITE_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=inertia-vue-lsk.test
SANCTUM_STATEFUL_DOMAINS=inertia-vue-lsk.test

MOBILE_APP_HEADER="X-YourApp-Mobile"
MOBILE_APP_URI_SCHEME="yourapp" # "://" will be appended automatically
MOBILE_APP_DEVICE_ID="X-YourApp-Device-Id"

MAIL_MAILER=smtp
MAIL_HOST=smtp.mailgun.org
MAIL_PORT=587
MAIL_USERNAME={username}.mailgun.org
MAIL_PASSWORD={password}
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="no-reply@localappdev.com"
MAIL_TO_ADDRESS="{your_mail}"
MAIL_FROM_NAME="${APP_NAME}"

FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

APPLE_CLIENT_ID=
APPLE_KEY_ID=
APPLE_TEAM_ID=
APPLE_PRIVATE_KEY=/resources/apple/{your_auth_key}.p8

FIREBASE_CREDENTIALS=resources/firebase/fcm-service-account.json

VITE_APP_NAME="${APP_NAME}"

# ---------------------------------------------

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=daily
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

FILESYSTEM_DISK=public
QUEUE_CONNECTION=redis

CACHE_STORE=redis
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

INERTIA_ENCRYPT_HISTORY=true
