{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "gtcrais/inertia-vue-lsk",
    "type": "project",
    "description": "The Inertia + Vue skeleton application for the Laravel framework.",
    "keywords": [
        "inertia",
        "vue",
        "starter-kit",
        "laravel"
    ],
    "license": "MIT",
    "require": {
        "php": "^8.4",
        "inertiajs/inertia-laravel": "^3.3.4",
        "intervention/image-laravel": "^4.1.1",
        "laravel-notification-channels/fcm": "^6.1",
        "laravel/framework": "^13.32.0",
        "laravel/sanctum": "^4.3.3",
        "laravel/socialite": "^5.31",
        "laravel/tinker": "^3.0.2",
        "predis/predis": "^3.6.0",
        "pusher/pusher-php-server": "^7.3",
        "socialiteproviders/apple": "^5.12"
    },
    "require-dev": {
        "fakerphp/faker": "^1.24.1",
        "fruitcake/laravel-debugbar": "^4.4.3",
        "laravel/boost": "^2.9",
        "laravel/pail": "^1.2.7",
        "laravel/pao": "^1.1.5",
        "laravel/pint": "^1.32.1",
        "laravel/sail": "^1.67",
        "mockery/mockery": "^1.6.15",
        "nunomaduro/collision": "^8.9.5",
        "pestphp/pest": "^5.2.0",
        "pestphp/pest-plugin-laravel": "^5.0.1"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi",
            "@php -r \"file_exists('database/database.sqlite') || touch('database/database.sqlite');\"",
            "@php artisan migrate --graceful --ansi"
        ],
        "dev": [
            "Composer\\Config::disableProcessTimeout",
            "@php artisan dev"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
